# GEMINI_API_KEY: Required for Gemini AI Health Assistant API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# GEMINI_MODEL: Configurable Gemini model ID for the Health Assistant.
# Defaults to gemini-4-hydrogen if omitted.
GEMINI_MODEL=gemini-4-hydrogen

# HUGGINGFACE_API_KEY: Optional server-side Hugging Face Inference Providers token (or HF_TOKEN).
# Configure via Settings > Secrets (or local .env); never put actual tokens in .env.example.
HUGGINGFACE_API_KEY=

# HUGGINGFACE_MODEL: Optional Hugging Face chat model ID.
HUGGINGFACE_MODEL=Qwen/Qwen3.5-9B

# PORT: Server port (defaults to 3000 in AI Studio runtime).
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL=
